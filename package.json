{
  "name": "vehicle-cli",
  "version": "1.0.0",
  "description": "",
  "bin": {
    "vehicle-cli" : "./dist/vehicle-cli.js"
  },  
  "scripts": {
    "build": "rm -rf ./dist && tsc",
    "start": "npm run build && node dist/index.js",
    "lint": "npx eslint ./src --fix",
    "start-db": "docker container run -d --name vehicle-database -e POSTGRES_USER=vehicle -e POSTGRES_PASSWORD=vehicle -e POSTGRES_DB=vehicle -p 5432:5432 postgis/postgis:16-3.4-alpine",
    "stop-db": "docker container rm -f vehicle-database",
    "test": "npx jest ./src",
    "package": "docker build -t bastier_heraud/vehicle-server:${TAG}",
    "publish": "docker image push bastier_heraud/vehicle-server:${TAG}",
    "release": "npm run package && npm run publish"
    "build-exec": "chmod +x dist/cli/vehicle-cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Timoonz/ci-cd-bastier-heraud.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Timoonz/ci-cd-bastier-heraud/issues"
  },
  "homepage": "https://github.com/Timoonz/ci-cd-bastier-heraud#readme",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.10",
    "@types/pg": "^8.16.0",
    "eslint": "^9.39.2",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  },
  "dependencies": {
    "@types/axios": "^0.9.36",
    "axios": "^1.13.4",
    "commander": "^14.0.3",
    "express": "^5.0.1",
    "pg": "^8.17.2"
  }
}
